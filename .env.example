# ─────────────────────────────────────────────────────────────
#  Condition Monitoring System — Environment Variables
#  Copy this file to .env and fill in real values before running
# ─────────────────────────────────────────────────────────────

# ── FastAPI ────────────────────────────────────────────────────
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=info

# ── Antigravity Feature Flag ───────────────────────────────────
# Set to 'true' to load v2 models (7-class) and enable new endpoints
ANTIGRAVITY_ENABLED=false

# ── Rotordynamic Parameters ────────────────────────────────────
# Shaft base speed in RPM (used for feature calculations)
SHAFT_RPM_DEFAULT=1500

# Precession frequency ratio for GPI calculation (0.43 per literature)
# Flag in CONTEXT.md → Open Questions if you need to change this
PRECESSION_RATIO=0.43

# Expected 1x harmonic amplitude under normal gravity (m/s², normalised)
EXPECTED_1X_AMPLITUDE=1.0
# Antigravity regime thresholds
ANTIGRAVITY_THRESHOLD_NEAR_ZERO=0.85
ANTIGRAVITY_THRESHOLD_REDUCED=0.30
# ── Sensor Parameters ─────────────────────────────────────────
# IIS3DWB sampling rate (Hz)
SENSOR_SAMPLE_RATE=26667

# Noise floor SNR for synthetic data generation (dB)
SYNTHETIC_SNR_DB=25

# ── CORS ──────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Data Paths ────────────────────────────────────────────────
FEATURES_TRAIN_PATH=data/processed/features_train.npy
LABELS_TRAIN_PATH=data/processed/labels_train.npy
ANTIGRAVITY_DATA_PATH=data/synthetic/antigravity_1024.npy
ANTIGRAVITY_LABELS_PATH=data/synthetic/antigravity_labels.npy

# ── Model Paths ───────────────────────────────────────────────
RF_MODEL_PATH=services/models/rf_model.pkl
LSTM_MODEL_PATH=services/models/lstm_model/
CGAN_MODEL_PATH=services/models/cgan_model/

RF_MODEL_V2_PATH=services/models/rf_model_v2.pkl
LSTM_MODEL_V2_PATH=services/models/lstm_model_v2/
